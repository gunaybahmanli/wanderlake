# Wanderlake environment variables
# Copy this file to .env and replace the placeholder values:
#   cp .env.example .env
# Never commit the real .env file (it is gitignored).
#
# Generate random secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# ---------- Postgres (pgvector/pgvector, Postgres 17) ----------
# Superuser and app database ("wanderlake", with the vector extension)
POSTGRES_USER=wanderlake
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wanderlake
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Iceberg JDBC catalog (database iceberg_catalog in the same Postgres, own role)
# Catalog name: shared by Trino (iceberg.jdbc-catalog.catalog-name) and PyIceberg. Must match,
# or they would see different tables. Do not change it once tables exist.
ICEBERG_CATALOG_NAME=wanderlake
ICEBERG_WAREHOUSE=s3://lakehouse/warehouse
ICEBERG_CATALOG_DB_USER=iceberg
ICEBERG_CATALOG_DB_PASSWORD=change-me

# ---------- S3 object storage (SeaweedFS locally, Cloudflare R2 in the cloud) ----------
# Clients must use path-style addressing.
# From the host: http://localhost:8333. From other compose services: http://seaweedfs:8333
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_REGION=us-east-1
S3_BUCKETS="raw lakehouse"
S3_PORT=8333
# SeaweedFS web UIs (local only)
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_MASTER_PORT=9333

# ---------- Source APIs ----------
# REST Countries v5 (https://restcountries.com, free plan: 1,000 requests/month). See the cloud runbook.
REST_COUNTRIES_API_KEY=change-me

# ---------- Trino (query profile) ----------
TRINO_PORT=8081

# ---------- Airflow (apache/airflow 3.x, standalone) ----------
# On Linux/WSL set this to your user id (`id -u`, usually 1000), as the Airflow docs recommend:
# the Airflow and one-off dbt containers then write mounted folders (dbt/target, logs) as you.
AIRFLOW_UID=1000
AIRFLOW_PORT=8080
# UI login (simple auth manager)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
# Metadata database role (created in Postgres on first start)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me
# Generate with: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW__CORE__FERNET_KEY=change-me
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW__API__SECRET_KEY=change-me
AIRFLOW__API_AUTH__JWT_SECRET=change-me

# ---------- Cloud (OpenTofu in infra/tofu; see docs/runbooks/cloud-setup.md) ----------
# Cloudflare: user API token with Account > Workers R2 Storage > Edit, this account only
CLOUDFLARE_API_TOKEN=change-me
TF_VAR_cloudflare_account_id=change-me-32-hex-chars
# Supabase: fine-grained organization access token (read/write, 90-day expiry)
SUPABASE_ACCESS_TOKEN=change-me
TF_VAR_supabase_org_id=change-me
# Avoid $ ` \ " ' in this password: the Makefile loads .env through the shell
TF_VAR_supabase_db_password=change-me-min-12-chars
# ---------- Cloud publish (DAG publish_cloud, make publish; see docs/runbooks/cloud-setup.md) ----------
# Cloudflare R2 S3 credentials: R2 API token, Object Read & Write, bucket wanderlake-lake only.
# The endpoint is built from TF_VAR_cloudflare_account_id in compose; region is "auto".
# Separate from the local S3_* (SeaweedFS) settings above.
CLOUD_S3_ACCESS_KEY=change-me
CLOUD_S3_SECRET_KEY=change-me
CLOUD_S3_BUCKET=wanderlake-lake
# Supabase Postgres through the session pooler (Connect > Session pooler); the password is
# TF_VAR_supabase_db_password above.
SUPABASE_DB_HOST=aws-0-eu-central-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.change-me-project-ref
SUPABASE_DB_NAME=postgres
# Public REST API (make api-check): project URL and the anon key (public by design: RLS
# limits it to SELECT on schema api). Never put the service_role key here.
SUPABASE_URL=https://change-me-project-ref.supabase.co
SUPABASE_ANON_KEY=change-me
# Vercel (step 12)
VERCEL_API_TOKEN=change-me
# OpenTofu state + plan encryption passphrase (min 16 chars). LOSING IT = LOSING THE STATE.
# Keep a copy in your password manager. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TF_VAR_state_passphrase=change-me-min-16-chars
