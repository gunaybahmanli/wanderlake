# Wanderlake environment variables
# Copy this file to .env and replace the placeholder values.
# Never commit the real .env file.

# ---------- Postgres ----------
# Operational database and pgvector store
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wanderlake
POSTGRES_USER=wanderlake
POSTGRES_PASSWORD=change-me

# ---------- MinIO ----------
# S3-compatible object storage for the Iceberg lakehouse
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-min-8-chars
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_LAKEHOUSE=wanderlake-lakehouse

# ---------- Airflow ----------
# Orchestration
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=change-me
# Generate with: openssl rand -hex 32
AIRFLOW__WEBSERVER__SECRET_KEY=change-me
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:change-me@localhost:5432/airflow
