# Normalize all text files to LF line endings
* text=auto eol=lf

# Binary files
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.pdf    binary
*.zip    binary
*.gz     binary
*.tar    binary
*.parquet binary
*.avro   binary
*.woff   binary
*.woff2  binary
